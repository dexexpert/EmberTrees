# =============================================================================
# CANNABIS DELIVERY PLATFORM - ENVIRONMENT VARIABLES
# =============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Ember Trees"

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://username:password@localhost:5432/ember_trees"
DIRECT_URL="postgresql://username:password@localhost:5432/ember_trees"

# =============================================================================
# AUTHENTICATION
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# =============================================================================
# CLOUD STORAGE (AWS S3)
# =============================================================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-west-2"
AWS_S3_BUCKET_NAME="ember-trees-assets"

# =============================================================================
# REDIS (Caching & Queues)
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# EMAIL SERVICES
# =============================================================================
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD=""
FROM_EMAIL="noreply@embertrees.com"

# =============================================================================
# SMS SERVICES (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# =============================================================================
# MAPPING & GEOLOCATION
# =============================================================================
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# =============================================================================
# EXTERNAL APIS
# =============================================================================

# Age Verification Service
AGE_VERIFICATION_API_KEY=""
AGE_VERIFICATION_API_URL=""

# Lab Results API
LAB_RESULTS_API_KEY=""

# Compliance Reporting
STATE_REPORTING_API_KEY=""
STATE_REPORTING_API_URL=""

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

GOOGLE_ANALYTICS_ID=""

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET="your-jwt-secret-here"
ENCRYPTION_KEY="your-encryption-key-here"

# Rate Limiting
RATE_LIMIT_REDIS_URL="redis://localhost:6379"

# =============================================================================
# CANNABIS-SPECIFIC COMPLIANCE
# =============================================================================

# State License Numbers
CANNABIS_LICENSE_NUMBER=""
DELIVERY_LICENSE_NUMBER=""

# Tax Configuration
STATE_CANNABIS_TAX_RATE=0.15
LOCAL_TAX_RATE=0.05
EXCISE_TAX_RATE=0.08

# Compliance Endpoints
METRC_API_KEY=""
METRC_USER_KEY=""
METRC_API_URL="https://api-ca.metrc.com"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_MEDICAL_CANNABIS=true
ENABLE_RECREATIONAL_CANNABIS=true
ENABLE_DELIVERY_TRACKING=true
ENABLE_LOYALTY_PROGRAM=true
ENABLE_REAL_TIME_NOTIFICATIONS=true

# =============================================================================
# BUSINESS CONFIGURATION
# =============================================================================
MINIMUM_ORDER_AMOUNT=25.00
DELIVERY_FEE=5.00
FREE_DELIVERY_THRESHOLD=75.00

# Age Verification
MINIMUM_AGE_RECREATIONAL=21
MINIMUM_AGE_MEDICAL=18

# Delivery Hours
DELIVERY_START_HOUR=9
DELIVERY_END_HOUR=22

# Service Areas (ZIP codes)
SERVICE_AREAS="90210,90211,90212,90213"

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
SKIP_AGE_VERIFICATION=false
MOCK_PAYMENT_PROCESSING=false
ENABLE_DEBUG_LOGS=true

# Test Data
TEST_USER_EMAIL="test@embertrees.com"
TEST_DRIVER_EMAIL="driver@embertrees.com"